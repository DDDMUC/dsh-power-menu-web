{
  "name": "dsh-power-menu-web",
  "version": "0.1.1",
  "description": "给 dsh web 部署加一个右上角电源按钮：刷新 / 重启 / 定时 / 关闭。重启后自动把新 token 的链接打开——dsh web 每次启动都换 token，不打开就得自己去日志里翻。macOS 走 launchd、Linux 走 systemd、其它平台自己 respawn。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "enable.sh",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "power",
    "power-menu",
    "restart",
    "web",
    "dsh-web"
  ],
  "author": "DDDMUC",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DDDMUC/dsh-power-menu-web.git"
  },
  "homepage": "https://github.com/DDDMUC/dsh-power-menu-web#readme",
  "bugs": {
    "url": "https://github.com/DDDMUC/dsh-power-menu-web/issues"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.1"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/helper.cjs && node -e \"const fs=require('node:fs'); JSON.parse(fs.readFileSync('package.json','utf8')); console.log('package.json ok')\"",
    "test": "npm run check"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  }
}
